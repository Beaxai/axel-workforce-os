{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "seed:users": "tsx src/scripts/seed-users.ts",
    "seed:wc-tracker": "tsx src/scripts/seed-wc-tracker.ts",
    "seed:peo-tracker": "tsx src/scripts/seed-peo-tracker.ts",
    "seed:subjectivities": "tsx src/scripts/seed-subjectivity-template.ts",
    "normalize:user-status": "tsx src/scripts/normalize-user-status.ts",
    "migrate:pipeline-stages": "tsx src/scripts/migrate-pipeline-stages.ts",
    "revert:pipeline-stages": "tsx src/scripts/revert-pipeline-stages.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.88.0",
    "@types/multer": "^2.1.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/cannabis-application": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/pipeline": "workspace:*",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.71.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "dotenv": "^17.3.1",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "pdf-lib": "^1.17.1",
    "pino": "^9",
    "pino-http": "^10",
    "socket.io": "^4.8.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "catalog:",
    "esbuild": "^0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
